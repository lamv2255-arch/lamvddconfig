{
  "name": "locket-gold-capybara",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute locket_gold_db --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute locket_gold_db --remote --file=./schema.sql",
    "db:seed": "wrangler d1 execute locket_gold_db --remote --file=./seed.sql"
  }
}
